<?xml version="1.0"?>
<ruleset name="Audriga Standard" namespace="Audriga\CS\Standard">
    <description>The coding standard for audriga.</description>

    <config name="php_version" value="80000"/>
    <!-- Include the whole PSR12 standard -->
    <rule ref="PSR12">
        <!-- ConstantVisibility requires explicit visibility on constants; excluded as it's not universally enforced -->
        <exclude name="PSR12.Properties.ConstantVisibility"/>
    </rule>
</ruleset>
